{
  "name": "exin-comunicacao",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@10.9.9",
  "workspaces": [
    "client",
    "server"
  ],
  "engines": {
    "node": ">=22.22.3 <27"
  },
  "overrides": {
    "vitest@^5.0.0": {
      "std-env": "4.2.0"
    }
  },
  "scripts": {
    "dev": "concurrently --kill-others-on-fail \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev --workspace=@exin/api",
    "dev:web": "npm run start --workspace=exin-client",
    "build": "npm run build --workspace=exin-client",
    "start": "npm run start --workspace=@exin/api",
    "test": "npm run test --workspace=@exin/api"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}